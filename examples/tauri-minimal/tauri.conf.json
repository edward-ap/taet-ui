{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tæt UI Example",
  "version": "0.1.0",
  "identifier": "local.taet-ui.example",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tæt UI form",
        "create": false,
        "width": 640,
        "height": 360,
        "minWidth": 400,
        "minHeight": 240,
        "dragDropEnabled": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        {
          "identifier": "example-only",
          "windows": [
            "main"
          ],
          "permissions": [
            "allow-echo"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
