{
  "name": "taet-ui",
  "version": "0.6.0-rc.4",
  "type": "module",
  "scripts": {
    "dev": "python scripts/dev-server.py --port 5173 --bind 127.0.0.1",
    "docs": "python scripts/dev-server.py --port 5174 --bind 127.0.0.1",
    "test:syntax": "node scripts/check-syntax.js",
    "test:unit": "node --test --test-concurrency=32 test/*.test.js",
    "test:browser": "node scripts/run-browser.js",
    "test": "npm run test:syntax && npm run test:api && npm run test:package && npm run test:unit && npm run test:types",
    "test:all": "npm test && npm run test:browser && npm run test:types:browser",
    "docs:api": "node scripts/check-api-docs.js --write",
    "test:api": "node scripts/check-api-docs.js",
    "test:types": "node scripts/check-package-types.js",
    "test:types:browser": "node scripts/check-package-types.js --browser",
    "test:compat": "node scripts/run-browser.js --config playwright.compat.config.js",
    "test:grid": "node scripts/run-browser.js --config playwright.grid.config.js",
    "test:charts": "node scripts/run-browser.js --config playwright.charts.config.js",
    "perf:check": "node scripts/check-grid-workloads.js",
    "perf:run": "node scripts/run-grid-workloads.js",
    "release:check": "node scripts/check-release.js",
    "build": "node scripts/build.js",
    "pretest:browser": "npm run build",
    "test:bundle": "npm run build && node scripts/check-bundle.js && node scripts/run-browser.js --config playwright.bundle.config.js",
    "test:webkit": "node scripts/run-browser.js --config playwright.compat.config.js --project=webkit",
    "test:package": "node scripts/check-package-boundaries.js",
    "distribution": "npm run build && python scripts/package-distribution.py"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "description": "Object-first compact desktop UI toolkit for WebView applications",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/ui/index.d.ts",
      "default": "./src/ui/index.js"
    },
    "./core": {
      "types": "./src/core/index.d.ts",
      "default": "./src/core/index.js"
    },
    "./experimental": {
      "types": "./src/ui/experimental.d.ts",
      "default": "./src/ui/experimental.js"
    },
    "./all": {
      "types": "./src/ui/all.d.ts",
      "default": "./src/ui/all.js"
    },
    "./inputs": {
      "types": "./src/ui/inputs.d.ts",
      "default": "./src/ui/inputs.js"
    },
    "./grid": {
      "types": "./src/ui/grid-api.d.ts",
      "default": "./src/ui/grid-api.js"
    },
    "./grid/editors": {
      "types": "./src/ui/GridEditors.d.ts",
      "default": "./src/ui/GridEditors.js"
    },
    "./taet-ui.css": "./src/ui/taet-ui.css",
    "./foundation": {
      "types": "./src/foundation/index.d.ts",
      "default": "./src/foundation/index.js"
    },
    "./components": {
      "types": "./src/components/index.d.ts",
      "default": "./src/components/index.js"
    },
    "./advanced": {
      "types": "./src/advanced/index.d.ts",
      "default": "./src/advanced/index.js"
    },
    "./dense.css": "./src/ui/dense.css"
  },
  "files": [
    "src/",
    "docs/",
    "spec/",
    "examples/ai-recipes/",
    "examples/basic-form/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "provenance/source-snapshot.json",
    "provenance/grid-candidate.json",
    "examples/grid-workbench/",
    "examples/grid-editors/",
    "examples/grid-transfer/",
    "examples/tree-move/",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "examples/tauri-minimal/",
    "examples/webview-standalone/"
  ],
  "main": "./src/ui/index.js",
  "module": "./src/ui/index.js",
  "types": "./src/ui/index.d.ts",
  "author": "Edward Aponasko",
  "keywords": [
    "ui",
    "desktop",
    "webview",
    "tauri",
    "controls",
    "taet-ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/edward-ap/taet-ui.git"
  },
  "homepage": "https://github.com/edward-ap/taet-ui#readme",
  "bugs": {
    "url": "https://github.com/edward-ap/taet-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  }
}
